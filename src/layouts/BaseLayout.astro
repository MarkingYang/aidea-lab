---
import '../styles/global.css';
import ArtalkStats from '../components/ArtalkStats.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string | null;
  ogType?: 'website' | 'article';
}

const {
  title = '大飞随笔｜AI 学习与思考',
  description = '记录 AI 浪潮下的随想与观察，聚焦思考、沉淀与实践，探寻新的学习范式，见证 AI 如何重塑认知与成长。',
  currentPath = Astro.url.pathname,
  image = null,
  ogType = 'website',
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const imageUrl = image ? new URL(image, pageUrl.origin) : null;
const navItems = [
  { href: '/topics/', label: '知识目录', mobileHidden: false },
  { href: '/series/', label: '专题阅读', mobileHidden: false },
  { href: '/library/', label: '全部文章', mobileHidden: true },
  { href: '/graph/', label: '知识星图', mobileHidden: false },
  { href: '/notes/', label: '随想', mobileHidden: true },
  { href: '/about/', label: '关于', mobileHidden: true },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('theme'); } catch {}
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#111210' : '#fbfaf7');
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="大飞随笔首页">
        <span class="wordmark-mark" aria-hidden="true">
          <img src="/brand/aidea-mark.png" alt="" width="32" height="32" />
        </span>
        <span class="wordmark-name">大飞随笔</span>
      </a>
      <div class="header-actions">
        <nav class="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a class:list={{ 'mobile-hidden': item.mobileHidden }} href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button class="theme-toggle" type="button" aria-label="切换深浅主题" title="切换深浅主题">
          <svg class="sun-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.2"></circle><path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16"></path></svg>
          <svg class="moon-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 12.8A7 7 0 0 1 7.2 3.5a7 7 0 1 0 9.3 9.3Z"></path></svg>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div><a href="/" class="footer-name">大飞随笔</a><p>思考、沉淀与实践。让理解慢慢发生。</p><p lang="en">Reflections on AI, learning, and the way we grow.</p></div><nav aria-label="页脚导航"><a href="/topics/">知识目录</a><a href="/series/">专题阅读</a><a href="/library/">全部文章</a><a href="/graph/">知识星图</a><a href="/notes/">随想</a><a href="/timeline/">时间线</a><a href="/about/">关于</a></nav></footer>
    <ArtalkStats />
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#111210' : '#fbfaf7');
        window.dispatchEvent(new CustomEvent('site-theme-change', { detail: { theme: next } }));
      });
    </script>
  </body>
</html>
