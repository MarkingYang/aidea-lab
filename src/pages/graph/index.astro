---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKnowledgeGraph } from '../../lib/knowledgeGraph';

const graph = await getKnowledgeGraph();
const serializedGraph = JSON.stringify(graph).replaceAll('<', '\\u003c');
---

<BaseLayout title="知识星图｜大飞随笔" description="从主题、系列、关键词与正文引用出发，在一张可缩放的知识地图中探索文章。">
  <div class="graph-page">
    <section class="graph-experience" data-graph-root aria-labelledby="graph-title">
      <div class="graph-atmosphere" aria-hidden="true"></div>
      <header class="graph-heading">
        <p class="eyebrow">Knowledge constellation</p>
        <h1 id="graph-title">知识星图</h1>
        <p class="graph-summary"><strong>{graph.stats.articles}</strong> 篇文章，<strong>{graph.stats.keywords}</strong> 个关键词，<strong>{graph.stats.references}</strong> 条正文引用</p>
      </header>

      <div class="graph-search">
        <label class="sr-only" for="graph-query">搜索文章、系列或主题</label>
        <div class="search-field">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
          <input id="graph-query" type="search" autocomplete="off" placeholder="搜索文章、系列或主题" aria-controls="graph-search-results" aria-expanded="false" />
          <kbd>⌘ K</kbd>
        </div>
        <div class="search-results" id="graph-search-results" role="listbox" hidden></div>
      </div>

      <details class="graph-tuning">
        <summary>显示与布局 <span aria-hidden="true">⌄</span></summary>
        <div class="tuning-content">
          <label for="graph-spacing">节点间距 <output data-spacing-output>1.0×</output></label>
          <input id="graph-spacing" data-graph-spacing type="range" min="0.6" max="2" step="0.1" value="1" />
          <label class="tuning-check"><input data-show-labels type="checkbox" checked />显示标题</label>
          <button type="button" data-reset-layout>恢复初始布局</button>
          <p>拖动节点可调整位置；滚轮缩放后会显示更多标题。</p>
        </div>
      </details>
      <div class="graph-canvas" data-graph-canvas tabindex="0" role="application" aria-describedby="graph-instructions" aria-label={`由 ${graph.nodes.length} 个可见节点、${graph.links.length} 条关系组成的可交互知识图谱`}></div>
      <div class="graph-loading" data-graph-loading><span></span><p>正在组织知识星群…</p></div>
      <p class="graph-error" data-graph-error hidden>图谱暂时没有完成渲染。你仍可以通过知识目录继续阅读。</p>

      <div class="graph-status" aria-live="polite">
        <span class="status-pulse" aria-hidden="true"></span><span data-graph-status>全局视野</span>
        <button type="button" data-clear-focus hidden>返回全图</button>
      </div>
      <p class="graph-hint" id="graph-instructions"><span class="desktop-hint">拖动节点或画布 · 滚轮缩放 · 点击探索关联</span><span class="mobile-hint">单指拖动，双指缩放；点按探索关联</span></p>

      <div class="graph-filters" aria-label="显示关系">
        <span>关系</span>
        <label><input type="checkbox" data-relation-filter="reference" checked />正文引用</label>
        <label><input type="checkbox" data-relation-filter="series,topic" checked />系列与主题</label>
        <label><input type="checkbox" data-relation-filter="keyword" checked />关键词</label>
        <label><input type="checkbox" data-relation-filter="similarity" />推测关联</label>
      </div>
      <div class="graph-controls" aria-label="图谱视图控制">
        <button type="button" data-zoom="in" aria-label="放大图谱" title="放大">+</button>
        <button type="button" data-zoom="out" aria-label="缩小图谱" title="缩小">−</button>
        <button type="button" data-zoom="reset" aria-label="重置图谱视图" title="重置视图"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7V3h4M4.7 4.8A7 7 0 1 1 3 11"></path></svg></button>
      </div>

      <button class="legend-toggle" type="button" data-legend-toggle aria-expanded="false" aria-controls="graph-legend"><span aria-hidden="true">?</span><span class="sr-only">查看图例</span></button>
      <div class="graph-legend" id="graph-legend" data-graph-legend hidden>
        <div><strong>节点</strong><span><i class="topic-node"></i>主题</span><span><i class="series-node"></i>系列</span><span><i class="keyword-node"></i>关键词</span><span><i class="article-node"></i>文章</span></div>
        <div><strong>关系</strong><span><i class="belongs-line"></i>归属</span><span><i class="keyword-line"></i>关键词</span><span><i class="reference-line"></i>引用</span><span><i class="similarity-line"></i>相似</span></div>
        <p>连线表示正文引用、系列归属或关键词。悬停突出直接关联；点击节点展开详情，从详情进入阅读。共享标签仅代表可能相关，可按需开启。</p>
      </div>

      <aside class="node-panel" data-node-panel data-open="false" aria-hidden="true" aria-live="polite" aria-label="节点详情" inert>
        <div class="panel-content" data-panel-content>
          <div class="panel-top"><p class="eyebrow" data-panel-kind></p><button type="button" data-panel-close aria-label="关闭节点详情">×</button></div>
          <h2 data-panel-title></h2>
          <p class="panel-description" data-panel-description></p>
          <div class="panel-tags" data-panel-tags></div>
          <a class="panel-primary" data-panel-link href="#">打开这篇内容 <span>↗</span></a>
          <div class="local-controls" aria-label="局部图范围">
            <span>关联范围</span><button type="button" data-depth="1" aria-pressed="true">一层</button><button type="button" data-depth="2" aria-pressed="false">两层</button>
            <label><input data-local-only type="checkbox" checked />仅看关联</label>
          </div>
          <div class="panel-relations"><div><h3>直接关联</h3><span data-panel-count></span></div><ul data-panel-relations></ul></div>
        </div>
      </aside>
    </section>

    <section class="graph-notes" aria-labelledby="graph-notes-title">
      <header><h2 id="graph-notes-title">不是目录的另一种画法，<br />而是文章之间的上下文。</h2></header>
      <div class="graph-note-grid">
        <article><h3>从领域进入</h3><p>较大的铜橙色节点代表主题。点击它，镜头会聚焦这一知识区域，但不会割裂它与全局的联系。</p></article>
        <article><h3>沿系列深入</h3><p>青绿色节点代表系列。关联文章自然聚集，点击后可沿章节继续阅读。</p></article>
        <article><h3>从关键词横向探索</h3><p>金色关键词把不同系列的文章连接起来；点击它会展开局部关系，再从文章标题直接进入阅读。</p></article>
      </div>
      <details class="graph-method"><summary>这些关系是如何生成的？</summary><p>节点与连线从当前 Markdown 内容生成。正文引用与系列关系拉近节点，节点间的排斥保持阅读空间，自然形成疏密不同的知识区域。主题归属采用较弱的牵引，共享标签的推测关联默认关闭。</p></details>
      <details class="graph-method graph-automation"><summary>新增文章后，图谱如何更新？</summary><p>把 Markdown 放入文章目录并保存即可。开发模式会随内容变更重新生成；正式发布时，构建过程会重新扫描全部文章，计算节点、关系、主题分区和二维坐标，再校验每篇文章都已进入图谱。独立文章不需要维护额外清单，只有加入有顺序的系列时才需要指定章节位置。</p></details>
    </section>
  </div>
  <script type="application/json" id="knowledge-graph-data" set:html={serializedGraph}></script>
</BaseLayout>

<script>
  import Graph from 'graphology';
  import Sigma from 'sigma';
  import { createGraphSimulation } from '../../lib/graphSimulation';

  const root = document.querySelector('[data-graph-root]');
  const canvas = root?.querySelector('[data-graph-canvas]');
  const dataElement = document.querySelector('#knowledge-graph-data');

  if (root instanceof HTMLElement && canvas instanceof HTMLElement && dataElement?.textContent) {
    const graphData = JSON.parse(dataElement.textContent);
    const nodeById = new Map(graphData.nodes.map((node) => [node.id, node]));
    const relationNames = { topic: '主题归属', series: '系列归属', keyword: '关键词关联', reference: '正文引用', similarity: '共享标签' };
    const kindNames = { topic: '阅读主题', series: '文章系列', keyword: '关键词', article: '文章' };
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const network = new Graph({ type: 'undirected', multi: true });

    const graphLabel = (title) => title.length > 20 ? `${title.slice(0, 19)}…` : title;
    for (const node of graphData.nodes) {
      network.addNode(node.id, {
        x: node.x ?? 0,
        y: node.y ?? 0,
        label: graphLabel(node.title),
        labelSide: node.labelSide ?? 'right',
        clusterId: node.clusterId,
        kind: node.kind,
        degree: node.degree,
        size: (node.kind === 'article' ? 2.4 : node.kind === 'series' ? 3 : 2) + Math.min(2.4, Math.sqrt(node.degree) * .35),
        zIndex: node.kind === 'topic' ? 4 : node.kind === 'series' ? 3 : node.kind === 'keyword' ? 2 : 1,
      });
    }
    for (const link of graphData.links) {
      const sourceNode = nodeById.get(link.source);
      const targetNode = nodeById.get(link.target);
      network.addEdgeWithKey(link.id, link.source, link.target, {
        relation: link.relation,
        local: sourceNode?.clusterId === targetNode?.clusterId,
        summary: false,
        weight: link.relation === 'topic' ? 3.4 : link.relation === 'series' ? 2.8 : link.relation === 'reference' ? 1.35 : link.relation === 'keyword' ? .48 : .72,
        size: link.relation === 'reference' ? 1.15 : link.relation === 'similarity' ? .65 : link.relation === 'keyword' ? .42 : .85,
      });
    }
    const enabledRelations = new Set(['reference', 'series', 'topic', 'keyword']);
    const rawNeighborIds = (id) => new Set(graphData.links.filter(link => enabledRelations.has(link.relation) && (link.source === id || link.target === id)).map(link => link.source === id ? link.target : link.source));
    root.dataset.localEdges = String(graphData.links.filter((link) => nodeById.get(link.source)?.clusterId === nodeById.get(link.target)?.clusterId).length);
    root.dataset.crossEdges = String(graphData.links.filter((link) => nodeById.get(link.source)?.clusterId !== nodeById.get(link.target)?.clusterId).length);
    root.dataset.layout = graphData.layout.type;
    root.dataset.edgeMode = 'overview';

    let renderer;
    let hoveredId = null;
    let selectedId = null;
    let focusIds = null;
    let localDepth = 1;
    let localOnly = true;
    let showLabels = true;
    let neighborIds = new Set();
    let visitedIds = new Set();
    try { visitedIds = new Set(JSON.parse(localStorage.getItem('knowledge-graph-visited') || '[]')); } catch {}

    const palette = () => document.documentElement.dataset.theme === 'dark'
      ? { topic: '#df7958', series: '#7caea4', keyword: '#c6a66a', article: '#bbb8b0', visited: '#9b8aba', muted: '#343530', edge: '#484d49', bridge: '#4b4d47', keywordEdge: '#6b604c', reference: '#a95c43', similarity: '#4f7770', label: '#e7e5df' }
      : { topic: '#b84d2e', series: '#3f756c', keyword: '#9a773d', article: '#79766f', visited: '#77618d', muted: '#d5d1c9', edge: '#c2beb6', bridge: '#b8b4ac', keywordEdge: '#b8aa8d', reference: '#b9654b', similarity: '#6d948d', label: '#302f2b' };
    const nodeColor = (node, colors = palette()) => visitedIds.has(node.id) && node.kind === 'article' ? colors.visited : colors[node.kind];
    const edgeColor = (relation, colors = palette()) => relation === 'bridge' ? colors.bridge : relation === 'reference' ? colors.reference : relation === 'similarity' ? colors.similarity : relation === 'keyword' ? colors.keywordEdge : colors.edge;
    const activeId = () => hoveredId || selectedId;
    const refreshRelations = () => {
      const active = activeId();
      neighborIds = new Set(active ? rawNeighborIds(active) : []);
      root.dataset.edgeMode = active ? 'detail' : 'overview';
      renderer?.scheduleRefresh();
    };

    try {
      const colors = palette();
      network.forEachNode((id) => network.mergeNodeAttributes(id, { color: nodeColor(nodeById.get(id), colors), labelColor: colors.label }));
      network.forEachEdge((id, attrs) => network.mergeEdgeAttributes(id, { color: edgeColor(attrs.relation, colors) }));

      renderer = new Sigma(network, canvas, {
        renderLabels: false,
        defaultDrawNodeHover: () => {},
        defaultNodeColor: colors.article,
        defaultEdgeColor: colors.edge,
        edgeReducer: (edge, attrs) => {
          const [source, target] = network.extremities(edge);
          const active = activeId();
          if (!enabledRelations.has(attrs.relation)) return { ...attrs, hidden: true };
          if (selectedId && focusIds && (!focusIds.has(source) || !focusIds.has(target))) return { ...attrs, hidden: true };
          if (!selectedId && active && source !== active && target !== active) return { ...attrs, hidden: true };

          return { ...attrs, color: active ? edgeColor(attrs.relation) : palette().edge, size: active ? 1.3 : .85, zIndex: active ? 2 : 1 };
        },
        hideEdgesOnMove: false,
        labelColor: { attribute: 'labelColor', color: colors.label },
        labelDensity: innerWidth < 760 ? .15 : .3,
        labelFont: "'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif",
        labelGridCellSize: 112,
        labelRenderedSizeThreshold: innerWidth < 760 ? 4.5 : 3.5,
        labelSize: 11,
        labelWeight: '400',
        maxCameraRatio: 1.22,
        minCameraRatio: .085,
        minEdgeThickness: .3,
        nodeReducer: (id, attrs) => {
          const node = nodeById.get(id);
          const active = activeId();
          const inFocus = !focusIds || focusIds.has(id);
          const inActiveNeighborhood = selectedId && !hoveredId ? inFocus : !active || id === active || neighborIds.has(id);
          const muted = !inActiveNeighborhood || !inFocus;
          return {
            ...attrs,
            hidden: Boolean(selectedId && localOnly && !inFocus),
            color: muted ? palette().muted : nodeColor(node),
            label: !inFocus ? '' : attrs.label,
            forceLabel: id === active,
            highlighted: id === active,
            size: id === active ? attrs.size * 1.5 : attrs.size,
            zIndex: id === active ? 9 : inActiveNeighborhood && active ? 7 : attrs.zIndex,
          };
        },
        stagePadding: innerWidth < 760 ? 34 : 70,
        zIndex: true,
      });
      renderer.setCustomBBox(renderer.getBBox());
      const camera = renderer.getCamera();
      const exposeCameraRatio = ({ ratio }) => { root.dataset.cameraRatio = ratio.toFixed(4); renderer.scheduleRefresh(); };
      camera.on('updated', exposeCameraRatio);
      exposeCameraRatio(camera.getState());

      const markVisited = (id) => {
        visitedIds.add(id);
        try { localStorage.setItem('knowledge-graph-visited', JSON.stringify([...visitedIds].slice(-120))); } catch {}
      };
      const linkedTo = (id) => {
        const grouped = new Map();
        for (const link of graphData.links) {
          if (!enabledRelations.has(link.relation) || (link.source !== id && link.target !== id)) continue;
          const targetId = link.source === id ? link.target : link.source;
          const previous = grouped.get(targetId);
          if (previous) previous.relations.add(relationNames[link.relation]);
          else grouped.set(targetId, { link, node: nodeById.get(targetId), relations: new Set([relationNames[link.relation]]) });
        }
        return [...grouped.values()].sort((a, b) => b.link.weight - a.link.weight || a.node.title.localeCompare(b.node.title, 'zh-CN'));
      };

      const panel = root.querySelector('[data-node-panel]');
      const panelTitle = root.querySelector('[data-panel-title]');
      const panelKind = root.querySelector('[data-panel-kind]');
      const panelDescription = root.querySelector('[data-panel-description]');
      const panelTags = root.querySelector('[data-panel-tags]');
      const panelLink = root.querySelector('[data-panel-link]');
      const panelCount = root.querySelector('[data-panel-count]');
      const panelRelations = root.querySelector('[data-panel-relations]');
      const graphStatus = root.querySelector('[data-graph-status]');
      const clearFocus = root.querySelector('[data-clear-focus]');

      const syncUrl = () => {
        const url = new URL(location.href);
        if (selectedId) { url.searchParams.set('node', selectedId); url.searchParams.set('view', 'local'); }
        else { url.searchParams.delete('node'); url.searchParams.delete('view'); }
        history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      };
      const updatePanel = (id) => {
        const node = id && nodeById.get(id);
        panel.dataset.open = node ? 'true' : 'false'; panel.setAttribute('aria-hidden', node ? 'false' : 'true'); panel.inert = !node;
        if (!node) return;
        const links = linkedTo(id);
        panelKind.textContent = kindNames[node.kind]; panelTitle.textContent = node.title;
        panelDescription.textContent = node.description || '从这里继续探索与它直接相连的内容。';
        panelTags.replaceChildren(...node.tags.slice(0, 5).map((tag) => { const item = document.createElement('span'); item.textContent = tag; return item; }));
        panelLink.href = node.href;
        panelLink.firstChild.textContent = node.kind === 'article' ? '阅读这篇文章 ' : node.kind === 'series' ? '打开系列目录 ' : node.kind === 'keyword' ? '查看关键词文章 ' : '打开主题目录 ';
        panelCount.textContent = `${links.length} 个节点`;
        panelRelations.replaceChildren(...links.map(({ link, node: target, relations }) => {
          const item = document.createElement('li'); const button = document.createElement('button');
          button.type = 'button'; button.dataset.nodeId = target.id;
          const meta = document.createElement('span'); meta.textContent = [...relations].join(' · ');
          const title = document.createElement('strong'); title.textContent = target.title;
          button.append(meta, title); item.append(button); return item;
        }));
      };
      const moveCamera = (ids) => requestAnimationFrame(() => {
        const points = [...ids].map((id) => renderer.getNodeDisplayData(id)).filter(Boolean);
        if (!points.length) return;
        const xs = points.map((point) => point.x); const ys = points.map((point) => point.y);
        const minX = Math.min(...xs); const maxX = Math.max(...xs); const minY = Math.min(...ys); const maxY = Math.max(...ys);
        const ratio = Math.max(.46, Math.min(.92, Math.max(maxX - minX, maxY - minY) * 1.8 || .5));
        const state = {
          x: (minX + maxX) / 2 + (innerWidth > 760 ? ratio * .14 : 0),
          y: (minY + maxY) / 2 - (innerWidth <= 760 ? ratio * .1 : 0),
          ratio,
        };
        if (reducedMotion) camera.setState(state);
        else camera.animate(state, { duration: 720, easing: 'quadraticInOut' });
      });
      const setSelection = (id, { move = true, sync = true } = {}) => {
        if (!nodeById.has(id)) return;
        const regionalIds = new Set([id, ...rawNeighborIds(id)]);
        if (localDepth === 2) for (const neighbor of [...regionalIds]) for (const next of rawNeighborIds(neighbor)) regionalIds.add(next);
        hoveredId = null;
        selectedId = id; focusIds = regionalIds;
        graphStatus.textContent = nodeById.get(id).title; clearFocus.hidden = false;
        updatePanel(id); refreshRelations(); if (move) moveCamera(new Set(regionalIds)); if (sync) syncUrl();
      };
      const resetView = ({ sync = true } = {}) => {
        selectedId = null; hoveredId = null; focusIds = null; neighborIds = new Set(); root.dataset.edgeMode = 'overview';
        graphStatus.textContent = '全局视野'; clearFocus.hidden = true; panel.dataset.open = 'false'; panel.setAttribute('aria-hidden', 'true'); panel.inert = true; renderer.scheduleRefresh();
        if (reducedMotion) camera.setState({ x: .5, y: .5, ratio: 1, angle: 0 });
        else camera.animatedReset({ duration: 620, easing: 'quadraticInOut' });
        if (sync) syncUrl();
      };

      const activateNode = (id) => {
        const item = nodeById.get(id);
        if (!item) return;
        setSelection(id);
      };

      // Lay out actual title boxes, not approximate label grid cells. The same
      // buttons provide pointer hit targets and keyboard access to visible nodes.
      const labelLayer = document.createElement('div');
      labelLayer.className = 'graph-label-layer';
      canvas.append(labelLayer);
      const labelButtons = new Map();
      const measure = document.createElement('canvas').getContext('2d');
      let labelBoxes = [];
      const intersects = (a, b) => a.x < b.x + b.width + 5 && a.x + a.width + 5 > b.x && a.y < b.y + b.height + 4 && a.y + a.height + 4 > b.y;
      const renderTitles = () => {
        labelBoxes = [];
        const ratio = camera.getState().ratio;
        const fontSize = innerWidth < 760 ? 10 : 11;
        measure.font = `${fontSize}px "PingFang SC", system-ui, sans-serif`;
        const points = graphData.nodes.map(node => {
          const display = renderer.getNodeDisplayData(node.id);
          return { node, display, point: display && renderer.framedGraphToViewport(display) };
        }).filter(item => item.display && !item.display.hidden);
        const priority = id => id === activeId() ? 100000 : id === selectedId ? 90000 : neighborIds.has(id) ? 10000 : 0;
        points.sort((a, b) => priority(b.node.id) - priority(a.node.id) || b.node.degree - a.node.degree);
        const visible = new Set();
        const canvasRect = canvas.getBoundingClientRect();
        const panelRect = panel.getBoundingClientRect();
        const panelBox = { x: panelRect.x - canvasRect.x, y: panelRect.y - canvasRect.y, width: panelRect.width, height: panelRect.height };
        for (const { node, display, point } of points) {
          if (!showLabels || !display.label) continue;
          const important = node.id === activeId() || node.id === selectedId;
          if (!important && !selectedId && ratio > .75 && node.kind !== 'series' && node.degree < 18) continue;
          if (!important && labelBoxes.length >= (innerWidth < 760 ? 10 : ratio > .75 ? 22 : 65)) continue;
          const text = node.title.length > (important ? 30 : 19) ? node.title.slice(0, important ? 29 : 18) + '…' : node.title;
          const width = Math.min(canvas.clientWidth - 24, measure.measureText(text).width + 8);
          const height = fontSize + 10;
          const radius = renderer.scaleSize(display.size) + 5;
          const candidates = [
            { x: point.x + radius, y: point.y - height / 2, width, height },
            { x: point.x - radius - width, y: point.y - height / 2, width, height },
            { x: point.x - width / 2, y: point.y - radius - height, width, height },
            { x: point.x - width / 2, y: point.y + radius, width, height },
          ];
          const box = candidates.find(box => box.x >= 6 && box.y >= 6 && box.x + width < canvas.clientWidth - 6 && box.y + height < canvas.clientHeight - 6
            && (!selectedId || !intersects(box, panelBox))
            && !labelBoxes.some(other => intersects(box, other))
            && (important || !points.some(other => other.node.id !== node.id && intersects(box, { x: other.point.x - 3, y: other.point.y - 3, width: 6, height: 6 }))));
          if (!box) continue;
          labelBoxes.push({ ...box, id: node.id });
          visible.add(node.id);
          let button = labelButtons.get(node.id);
          if (!button) {
            button = document.createElement('button'); button.type = 'button';
            button.dataset.graphNodeLabel = node.id;
            button.setAttribute('aria-label', node.title);
            button.addEventListener('click', event => { event.stopPropagation(); activateNode(node.id); });
            labelLayer.append(button); labelButtons.set(node.id, button);
          }
          button.hidden = false;
          button.textContent = text;
          button.dataset.active = String(important);
          button.style.cssText = `left:${box.x}px;top:${box.y}px;width:${width}px;height:${height}px;font-size:${fontSize}px`;
        }
        for (const [id, button] of labelButtons) button.hidden = !visible.has(id);
      };
      renderer.on('afterRender', renderTitles);
      renderTitles();
      const labelAt = ({ x, y }) => labelBoxes.find(box => x >= box.x && x <= box.x + box.width && y >= box.y && y <= box.y + box.height)?.id;

      const physicsNodes = graphData.nodes.map(node => ({ ...node, vx: 0, vy: 0 }));
      const physicsById = new Map(physicsNodes.map(node => [node.id, node]));
      const simulation = createGraphSimulation(physicsNodes, graphData.links).alpha(.08);
      simulation.on('tick', () => {
        network.updateEachNodeAttributes((id, attrs) => ({ ...attrs, x: physicsById.get(id).x, y: physicsById.get(id).y }));
      });
      let dragged = null;
      let dragStart = null;
      let didDrag = false;
      let suppressClickUntil = 0;
      renderer.on('downNode', ({ node, event }) => {
        if (event.original.button && event.original.button !== 0) return;
        dragged = physicsById.get(node);
        dragStart = { x: event.x, y: event.y };
        didDrag = false;
        camera.disable();
      });
      renderer.getMouseCaptor().on('mousemovebody', event => {
        if (!dragged) return;
        event.preventSigmaDefault();
        event.original.preventDefault();
        event.original.stopPropagation();
        if (!didDrag && Math.hypot(event.x - dragStart.x, event.y - dragStart.y) < 4) return;
        didDrag = true;
        const point = renderer.viewportToGraph(event);
        dragged.fx = point.x; dragged.fy = point.y;
        dragged.x = point.x; dragged.y = point.y;
        network.mergeNodeAttributes(dragged.id, point);
        if (!reducedMotion) simulation.alphaTarget(.08).restart();
        canvas.style.cursor = 'grabbing';
      });
      const finishDrag = () => {
        if (!dragged) return;
        dragged.fx = null; dragged.fy = null;
        if (didDrag) {
          suppressClickUntil = performance.now() + 250;
          if (!reducedMotion) simulation.alphaTarget(0).alpha(.15).restart();
        }
        dragged = null;
        camera.enable();
        canvas.style.cursor = '';
      };
      window.addEventListener('mouseup', finishDrag);
      window.addEventListener('blur', finishDrag);
      window.addEventListener('pagehide', () => simulation.stop(), { once: true });
      const spacing = root.querySelector('[data-graph-spacing]');
      const updatePositions = () => network.updateEachNodeAttributes((id, attrs) => ({ ...attrs, x: physicsById.get(id).x, y: physicsById.get(id).y }));
      spacing.addEventListener('input', () => {
        const value = Number(spacing.value);
        root.querySelector('[data-spacing-output]').textContent = value.toFixed(1) + '×';
        simulation.force('charge').strength(-100 * value);
        simulation.alpha(.25);
        if (reducedMotion) { simulation.stop().tick(160); updatePositions(); }
        else simulation.restart();
      });
      root.querySelector('[data-reset-layout]').addEventListener('click', () => {
        simulation.stop().alpha(0).alphaTarget(0);
        simulation.force('charge').strength(-100);
        for (const original of graphData.nodes) Object.assign(physicsById.get(original.id), { x: original.x, y: original.y, vx: 0, vy: 0, fx: null, fy: null });
        spacing.value = '1'; root.querySelector('[data-spacing-output]').textContent = '1.0×';
        updatePositions(); resetView();
      });
      root.querySelector('[data-show-labels]').addEventListener('change', event => { showLabels = event.target.checked; renderTitles(); });
      root.querySelector('[data-local-only]').addEventListener('change', event => { localOnly = event.target.checked; renderer.scheduleRefresh(); });
      root.querySelectorAll('[data-depth]').forEach(button => button.addEventListener('click', () => {
        localDepth = Number(button.dataset.depth);
        root.querySelectorAll('[data-depth]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        if (selectedId) setSelection(selectedId);
      }));
      root.querySelectorAll('[data-relation-filter]').forEach(input => {
        input.addEventListener('change', () => {
          const relations = input.dataset.relationFilter.split(',');
          relations.forEach(relation => input.checked ? enabledRelations.add(relation) : enabledRelations.delete(relation));
          if (selectedId) setSelection(selectedId, { move: false });
          refreshRelations();
        });
      });

      let pointerOnNode = false;
      const updatePointer = (pointerOnLabel = false) => { canvas.dataset.interactive = String(pointerOnNode || pointerOnLabel); };

      renderer.on('enterNode', ({ node }) => { pointerOnNode = true; updatePointer(); hoveredId = node; refreshRelations(); });
      renderer.on('leaveNode', () => { pointerOnNode = false; updatePointer(); hoveredId = null; refreshRelations(); });
      renderer.on('clickNode', ({ node, event }) => {
        event.preventSigmaDefault();
        if (performance.now() < suppressClickUntil) return;
        activateNode(node);
      });
      renderer.on('clickStage', ({ event }) => {
        if (performance.now() < suppressClickUntil) return;
        const labelNode = labelAt(event);
        if (labelNode) { event.preventSigmaDefault(); activateNode(labelNode); return; }
        resetView();
      });
      renderer.getMouseCaptor().on('mousemove', (event) => updatePointer(Boolean(labelAt(event))));

      root.querySelector('[data-panel-close]')?.addEventListener('click', () => resetView());
      clearFocus?.addEventListener('click', () => resetView());
      panelRelations?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-node-id]'); if (!button) return;
        const node = nodeById.get(button.dataset.nodeId);
        activateNode(node.id);
      });
      panelLink?.addEventListener('click', () => { if (selectedId && nodeById.get(selectedId)?.kind === 'article') markVisited(selectedId); });
      root.querySelectorAll('[data-zoom]').forEach((button) => button.addEventListener('click', () => {
        const action = button.dataset.zoom;
        if (action === 'reset') resetView();
        else if (action === 'in') camera.animatedZoom({ factor: 1.3, duration: reducedMotion ? 1 : 260 });
        else camera.animatedUnzoom({ factor: 1.3, duration: reducedMotion ? 1 : 260 });
      }));

      const query = root.querySelector('#graph-query');
      const results = root.querySelector('#graph-search-results');
      const closeResults = () => { results.hidden = true; query.setAttribute('aria-expanded', 'false'); };
      const search = () => {
        const value = query.value.trim().toLocaleLowerCase('zh-CN'); if (!value) return closeResults();
        const matches = graphData.nodes.filter((node) => `${node.title} ${node.description} ${node.tags.join(' ')}`.toLocaleLowerCase('zh-CN').includes(value)).sort((a, b) => b.degree - a.degree).slice(0, 7);
        results.replaceChildren(...matches.map((node) => {
          const button = document.createElement('button'); button.type = 'button'; button.role = 'option'; button.dataset.nodeId = node.id;
          const type = document.createElement('span'); type.textContent = kindNames[node.kind]; const title = document.createElement('strong'); title.textContent = node.title;
          button.append(type, title); return button;
        }));
        if (!matches.length) { const empty = document.createElement('p'); empty.textContent = '没有找到匹配节点'; results.append(empty); }
        results.hidden = false; query.setAttribute('aria-expanded', 'true');
      };
      query?.addEventListener('input', search);
      results?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-node-id]'); if (!button) return;
        const node = nodeById.get(button.dataset.nodeId); query.value = node.title; closeResults();
        activateNode(node.id);
      });

      const legendToggle = root.querySelector('[data-legend-toggle]');
      const legend = root.querySelector('[data-graph-legend]');
      legendToggle?.addEventListener('click', () => { const open = legend.hidden; legend.hidden = !open; legendToggle.setAttribute('aria-expanded', String(open)); });
      document.addEventListener('click', (event) => {
        if (!root.querySelector('.graph-search')?.contains(event.target)) closeResults();
        if (!legend.contains(event.target) && !legendToggle.contains(event.target)) { legend.hidden = true; legendToggle.setAttribute('aria-expanded', 'false'); }
      });
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); query?.focus(); }
        if (event.key === 'Escape') { closeResults(); query?.blur(); if (selectedId) resetView(); }
      });

      const requestedNode = new URL(location.href).searchParams.get('node');
      if (requestedNode && nodeById.has(requestedNode)) setSelection(requestedNode, { move: true, sync: false });
      root.querySelector('[data-graph-loading]')?.setAttribute('hidden', '');
      window.addEventListener('site-theme-change', () => {
        const next = palette();
        network.forEachNode((id) => network.mergeNodeAttributes(id, { color: nodeColor(nodeById.get(id), next), labelColor: next.label }));
        network.forEachEdge((id, attrs) => network.mergeEdgeAttributes(id, { color: edgeColor(attrs.relation, next) }));
        renderer.setSettings({ defaultNodeColor: next.article, defaultEdgeColor: next.edge, labelColor: { attribute: 'labelColor', color: next.label } });
      });
    } catch (error) {
      console.error('Knowledge graph failed to initialize', error);
      root.querySelector('[data-graph-loading]')?.setAttribute('hidden', ''); root.querySelector('[data-graph-error]')?.removeAttribute('hidden');
    }
  }
</script>

