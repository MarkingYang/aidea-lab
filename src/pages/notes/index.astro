---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => data.type !== 'essay')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="随想｜大飞随笔" description="短想法、每周信号与仍在生长的 AI 学习记录。">
  <div class="page-shell">
    <header class="page-intro">
      <div><p class="eyebrow">NOTES & SIGNALS</p><h1>笔记，不急着<br />成为文章。</h1></div>
      <p class="intro-copy">捕捉还没有完整结构的观察。它们可能继续生长，也可能只是帮助我记住一次认知变化。</p>
    </header>
    <div class="count-line"><span>{String(entries.length).padStart(2, '0')} ENTRIES</span><span>按时间倒序</span></div>
    <section class="content-grid" aria-label="笔记列表">
      {entries.slice(0,12).map((entry, index) => <ContentCard entry={entry} index={index} />)}
    </section>
    {entries.length===0 && <div class="empty-note"><p>这里留给尚未长成文章的观察。目前还没有单独发布的短笔记，不必为了填满目录而匆忙写下结论。</p><a class="text-link" href="/topics/perspectives/">先读认知与观察方向的文章 →</a></div>}
    {entries.length>12 && <a class="text-link" href="/library/">进入完整归档，按类型检索更多记录 →</a>}
  </div>
</BaseLayout>
