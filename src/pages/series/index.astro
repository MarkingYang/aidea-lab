---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesRow from '../../components/SeriesRow.astro';
import { getKnowledge, topics } from '../../lib/knowledge';
const {series} = await getKnowledge();
---
<BaseLayout title="专题阅读｜大飞随笔" description="按知识域选择专题，再进入模块、方法或项目文章。">
  <div class="page-shell">
    <header class="page-intro"><p class="eyebrow">A little further, one chapter at a time</p><h1>按问题进入，<br />按模块深入。</h1><p class="intro-copy">每个专题都从高层骨架开始，在中间章节进入细节与实践，最终回到整个体系。可以顺序读，也可以带着问题回访。</p></header>
    {topics.map(topic=>{const items=series.filter(item=>item.topic===topic.id);return items.length>0 && <section class="directory-section"><div class="section-heading"><h2>{topic.title}</h2><a href={`/topics/${topic.id}/`}>此方向的更多观察 ↗</a></div><div class="ruled-list">{items.map((item,index)=><SeriesRow series={item} index={index}/>)}</div></section>})}
  </div>
</BaseLayout>
