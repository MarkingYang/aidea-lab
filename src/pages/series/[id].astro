---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKnowledge, topics, articleHref, shortTitle, stageLabel, dateLabel } from '../../lib/knowledge';
export async function getStaticPaths() { const { series }=await getKnowledge(); return series.map(item=>({params:{id:item.id},props:{series:item}})); }
const {series}=Astro.props;
const topic=topics.find(item=>item.id===series.topic)!;
---
<BaseLayout title={`${series.title}｜专题阅读｜大飞随笔`} description={series.description}>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="面包屑"><a href="/topics/">知识目录</a><span>/</span><a href={`/topics/${topic.id}/`}>{topic.title}</a><span>/</span><span aria-current="page">{series.title}</span></nav>
    <header class="series-header"><div class="page-intro"><p class="eyebrow">{series.articles.length} chapters · Articles in this topic</p><h1>{series.title}</h1><p class="intro-copy">{series.description}</p><p class="series-facts">{series.articles.length} 篇 · 总阅读约 {series.minutes} 分钟，实践另计<br/>最近修订 {dateLabel(series.updatedAt)}</p><a class="primary-link" href={articleHref(series.articles[0].id)}>阅读第一篇 <span aria-hidden="true">→</span></a></div></header>
    <section class="chapter-section" aria-labelledby="chapter-title"><div class="section-heading"><h2 id="chapter-title">阅读目录</h2><span class="quiet-label">按问题选择文章</span></div><ol class="chapter-list">{series.articles.map((entry,index)=><li><span class="chapter-number">{String(index+1).padStart(2,'0')}</span><div><p class="chapter-stage">{stageLabel(index,series.articles.length)}</p><h3><a href={articleHref(entry.id)}>{shortTitle(entry.data.title)}</a></h3><p>{entry.data.description}</p></div><span class="chapter-duration">{entry.data.readingTime}</span></li>)}</ol></section>
    <div class="series-finish"><p class="eyebrow">The question stays open</p><p>需要另一模块的知识时，回到知识目录继续选择。</p><a class="text-link" href="/series/">寻找下一条阅读路径 →</a></div>
  </div>
</BaseLayout>
<style>
  .series-header { display:grid; grid-template-columns:minmax(0,1fr); gap:80px; align-items:start; }
  .series-facts { color:var(--text-soft); font-size:12px; line-height:1.9; margin:24px 0; }
  .reading-outcome { padding:28px; background:var(--surface); border-top:2px solid var(--accent); }
  .reading-outcome > p:not(.eyebrow) { margin:18px 0 28px; color:var(--text-body); font-size:14px; line-height:1.9; }
  .reading-outcome > div { border-top:1px solid var(--line); padding-top:22px; } .reading-outcome small { color:var(--text-soft); font-size:11px; } .reading-outcome strong { display:block; font:400 23px/1.7 var(--display); margin-top:12px; }
  .chapter-section { margin-top:65px; } .chapter-list { list-style:none; padding:0; margin:0; border-top:1px solid var(--line); }
  .chapter-list li { display:grid; grid-template-columns:55px minmax(0,1fr) 75px; gap:25px; border-bottom:1px solid var(--line); padding:30px 0; }
  .chapter-number { font:400 30px var(--display); color:var(--text-soft); padding-top:20px; } .chapter-stage { color:var(--accent); font-size:11px; margin:0 0 12px; }
  h3 { margin:0; font:400 24px/1.5 var(--display); } h3 a { text-decoration:none; } h3 a:hover { color:var(--accent); }
  li div > p:last-child { max-width:820px; color:var(--text-soft); font-size:13px; line-height:1.8; margin:10px 0 0; } .chapter-duration { align-self:center; color:var(--text-soft); font:11px var(--mono); text-align:right; }
  .series-finish { padding:40px 0 0; } .series-finish > p:not(.eyebrow) { font:400 24px/1.7 var(--display); }
  @media(max-width:720px) { .series-header { grid-template-columns:1fr; gap:35px; } .chapter-list li { grid-template-columns:28px minmax(0,1fr); gap:15px; } .chapter-duration { grid-column:2; text-align:left; } .chapter-number { font-size:24px; } h3 { font-size:22px; } }
</style>
