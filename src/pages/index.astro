---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const writing = (await getCollection('writing')).sort(
  (a, b) => (b.data.updatedAt ?? b.data.publishedAt).valueOf() - (a.data.updatedAt ?? a.data.publishedAt).valueOf(),
);
const topicStats = [...new Set(writing.flatMap((entry) => entry.data.topics))]
  .map((topic) => ({ topic, count: writing.filter((entry) => entry.data.topics.includes(topic)).length }))
  .sort((a, b) => b.count - a.count || a.topic.localeCompare(b.topic, 'zh-CN'))
  .slice(0, 7);
---

<BaseLayout>
  <div class="home-shell">
    <section class="hero">
      <p class="eyebrow">PERSONAL AI FIELD NOTES · SINCE 2026</p>
      <h1>记录 AI 时代，<br />仍在形成的判断。</h1>
      <div class="hero-bottom">
        <p>关于人工智能、产品与人的长期笔记。这里保留想法出现、变化和被修正的过程。</p>
        <a href="#latest">浏览最近记录 <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <nav class="topic-shelf" aria-label="主题分类">
      <a class="shelf-label" href="/topics/">全部主题</a>
      {topicStats.map(({ topic, count }) => <a href="/topics/"><span>{topic}</span><small>{count}</small></a>)}
    </nav>

    <section class="latest" id="latest">
      <div class="collection-heading">
        <div><p class="eyebrow">WRITING INDEX</p><h2>浏览记录</h2></div>
        <span class="latest-label">最新发布</span>
      </div>

      <div>
        <p class="panel-note">{String(writing.length).padStart(2, '0')} 条记录，按最近发布或修订时间排列</p>
        <div class="home-grid">
          {writing.map((entry, index) => <ContentCard entry={entry} index={index} />)}
        </div>
        <a class="all-writing" href="/notes/">查看全部笔记 <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="manifesto">
      <p class="eyebrow">CURRENT QUESTION</p>
      <p>Agent Harness 如何真正进入工作流，<br />而不只是增加一个新的聊天窗口？</p>
      <a href="/topics/">沿着这个问题继续阅读 →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .home-shell { width: var(--page); margin: 0 auto; }
  .hero { padding: var(--space-page-top) 0 52px; }
  .hero h1 { max-width: 920px; margin: 16px 0 0; font-family: var(--display); font-size: var(--display-hero-size); font-weight: 400; line-height: 1.08; letter-spacing: -.045em; text-wrap: balance; }
  .hero-bottom { max-width: 920px; margin-top: 32px; display: grid; grid-template-columns: minmax(0, 620px) auto; align-items: end; gap: 36px; }
  .hero-bottom p { margin: 0; color: var(--text-soft); font-size: 15px; line-height: 1.8; text-wrap: pretty; }
  .hero-bottom a { justify-self: end; color: var(--text-soft); font-size: 13px; text-underline-offset: 5px; }
  .hero-bottom a span { display: inline-block; margin-left: 6px; }
  .topic-shelf { padding: 13px 0; display: flex; gap: 8px; overflow-x: auto; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); scrollbar-width: none; }
  .topic-shelf::-webkit-scrollbar { display: none; }
  .topic-shelf a { flex: 0 0 auto; padding: 8px 12px; display: inline-flex; align-items: center; gap: 9px; border-radius: 8px; background: var(--surface); color: var(--text-soft); font-size: 12px; text-decoration: none; transition: color .2s ease, background-color .2s ease; }
  .topic-shelf small { color: currentColor; font: 9px var(--mono); opacity: .6; }
  .topic-shelf a:hover { color: var(--text); background: var(--surface-strong); }
  .topic-shelf .shelf-label { background: var(--text); color: var(--bg); }
  .latest { padding: var(--space-section) 0 24px; }
  .collection-heading { margin-bottom: 24px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .collection-heading h2 { margin: 8px 0 0; font-family: var(--display); font-size: var(--display-section-size); font-weight: 400; letter-spacing: -.03em; }
  .latest-label { padding: 8px 11px; border-radius: 8px; background: var(--surface); color: var(--text-soft); font: 9px var(--mono); letter-spacing: .06em; }
  .panel-note { margin: 0 0 22px; color: var(--text-soft); font: 10px/1.7 var(--mono); }
  .home-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 16px; }
  .all-writing { width: fit-content; margin-top: 38px; padding: 10px 13px; display: block; border-radius: 8px; background: var(--surface); color: var(--text-soft); font-size: 13px; text-decoration: none; }
  .all-writing:hover { color: var(--text); background: var(--surface-strong); }
  .manifesto { margin-top: var(--space-section-lg); padding: clamp(40px, 5vw, 64px); border-radius: var(--radius-lg); background: var(--text); color: var(--bg); }
  .manifesto .eyebrow { color: currentColor; opacity: .55; }
  .manifesto > p:not(.eyebrow) { max-width: 920px; margin: 34px 0 42px; font-family: var(--display); font-size: clamp(30px, 3.8vw, 48px); line-height: 1.28; letter-spacing: -.03em; text-wrap: balance; }
  .manifesto a { font-size: 13px; text-underline-offset: 5px; }
  @media (max-width: 900px) { .home-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .hero { padding: var(--space-page-top) 0 42px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 20px; margin-top: 26px; }
    .hero-bottom a { justify-self: start; }
    .latest { padding-top: 52px; }
    .collection-heading { align-items: flex-start; flex-direction: column; }
    .home-grid { grid-template-columns: 1fr; gap-block: 36px; }
    .manifesto { margin-top: 64px; padding: 32px 22px; }
  }
</style>
