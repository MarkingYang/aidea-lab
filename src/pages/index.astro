---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesRow from '../components/SeriesRow.astro';
import EntryRow from '../components/EntryRow.astro';
import { getKnowledge, topics, articleHref, updated } from '../lib/knowledge';
const { entries, series, seriesByArticle } = await getKnowledge();
const featured = ['harness-integration', 'agent-evaluation', 'agent-memory'].map(id => series.find(item => item.id === id)!);
const seen = new Set<string>();
const latest = entries.flatMap(entry => {
  const parent = seriesByArticle.get(entry.id);
  const key = parent?.id ?? entry.id;
  if (seen.has(key)) return [];
  seen.add(key);
  return [{ entry: parent ? { ...parent.articles[0], data: { ...parent.articles[0].data, description: parent.description, updatedAt: parent.updatedAt } } : entry, parent }];
}).sort((a,b) => updated(b.entry).valueOf() - updated(a.entry).valueOf()).slice(0,6);
---
<BaseLayout>
  <div class="home-shell">
    <section class="hero">
      <div class="hero-writing">
        <p class="eyebrow">Thinking · Reflection · Practice</p>
        <h1>在 AI 浪潮里，<br />重塑新的<span>成长范式</span></h1>
        <p class="hero-copy">记录 AI 浪潮下的随想与观察，在技术迭代的洪流之中，探寻属于这个时代全新的学习范式。不追逐转瞬即逝的热点，聚焦思考、沉淀与实践，见证 AI 如何重塑认知、重构我们获取知识与成长的方式。</p>
        <a class="text-link" href="/topics/">从知识目录开始 <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="question-index" aria-label="从问题选择阅读方向">
        <p class="eyebrow">从一个问题开始</p>
        {topics.map((topic,index) => <a href={`/topics/${topic.id}/`}><span class="question-number">0{index + 1}</span><div><small>{topic.title}</small><strong>{topic.question}</strong></div><span aria-hidden="true">↗</span></a>)}
        <p class="index-note">没有唯一的起点。沿着你正在思考的问题，慢慢读。</p>
      </nav>
    </section>
    <div class="garden-line"><span>一份持续生长的学习记录</span><span>{topics.length} 个方向 <i>/</i> {series.length} 个专题 <i>/</i> {entries.length} 篇记录</span></div>
    <section class="home-section reading-paths" aria-labelledby="paths-title">
      <div class="section-intro"><p class="eyebrow">Read in sequence</p><h2 id="paths-title">把一个问题，<br />读得更深。</h2><p>按架构、评测或产品问题选择专题。每篇回答一个具体问题，也可以直接进入模块与案例。</p><a class="text-link" href="/series/">全部 {series.length} 个专题 →</a></div>
      <div class="featured-series">{featured.map((item,index) => <SeriesRow series={item} index={index} />)}</div>
    </section>
    <section class="home-section" id="latest">
      <div class="section-heading"><div><p class="eyebrow">Recently revised</p><h2>最近写下，也重新想过。</h2></div><a href="/library/">检索全部文章 ↗</a></div>
      <p class="section-note">同一专题的修订合并展示。时间只是入口，不是价值的排序。</p>
      <div class="recent-list">{latest.map(({entry,parent}) => <EntryRow entry={entry} seriesTitle={parent?.title} href={parent ? `/series/${parent.id}/` : articleHref(entry.id)} />)}</div>
    </section>
    <section class="closing-note"><p class="eyebrow">A note on learning</p><p>不急着收集更多答案，<br />先让一个问题真正改变自己。</p><a class="text-link" href="/about/">关于这里的记录方式 →</a></section>
  </div>
</BaseLayout>
<style>
  .home-shell { width:var(--page); margin:auto; }
  .hero { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(290px,1fr); gap:clamp(40px,7vw,108px); padding:80px 0 56px; }
  h1 { margin:24px 0; font:400 clamp(42px,4.3vw,62px)/1.25 var(--display); letter-spacing:-.04em; text-wrap:balance; }
  h1 span { color:var(--accent); }
  .hero-copy { max-width:640px; color:var(--text-body); font-size:14px; line-height:2; margin:0 0 26px; }
  .question-index { align-self:center; border-top:1px solid var(--line-strong); padding-top:18px; }
  .question-index > a { display:grid; grid-template-columns:22px 1fr 15px; gap:14px; padding:22px 0; text-decoration:none; border-bottom:1px solid var(--line); transition:color .2s; }
  .question-index > a:hover { color:var(--accent); }
  .question-number { padding-top:3px; color:var(--accent); font:10px var(--mono); }
  .question-index small { color:var(--text-soft); display:block; margin-bottom:8px; font-size:11px; }
  .question-index strong { display:block; font:400 18px/1.7 var(--display); }
  .index-note { margin:17px 0 0; font-size:11px; color:var(--text-soft); line-height:1.8; }
  .garden-line { padding:18px 0; border-block:1px solid var(--line); display:flex; justify-content:space-between; gap:16px; font-size:11px; color:var(--text-soft); font-variant-numeric:tabular-nums; }
  .garden-line i { font-style:normal; margin:0 12px; color:var(--line-strong); }
  .home-section { padding-top:76px; }
  .reading-paths { display:grid; grid-template-columns:minmax(210px,.6fr) minmax(0,1.4fr); gap:80px; }
  .section-intro { padding-top:30px; }
  .section-intro h2 { font:400 34px/1.4 var(--display); margin:17px 0; }
  .section-intro > p:not(.eyebrow) { max-width:280px; font-size:14px; line-height:1.9; color:var(--text-soft); margin-bottom:28px; }
  .featured-series { border-top:1px solid var(--line); }
  .section-heading h2 { margin-top:14px; }
  .section-note { font-size:12px; color:var(--text-soft); margin:0 0 20px; }
  .recent-list { border-top:1px solid var(--line); }
  .closing-note { margin:88px 0 0; padding:40px 0 54px; border-top:1px solid var(--line); }
  .closing-note > p:not(.eyebrow) { font:400 clamp(26px,3vw,36px)/1.6 var(--display); margin:22px 0; }
  @media(max-width:1000px) { .hero { gap:40px; } .reading-paths { gap:35px; } }
  @media(max-width:760px) { .hero { grid-template-columns:1fr; padding-top:44px; gap:34px; } .hero h1 { font-size:clamp(35px,7.8vw,52px); } .reading-paths { grid-template-columns:1fr; gap:20px; } .section-intro { padding:0; } .section-intro h2 br { display:none; } .section-intro > p:not(.eyebrow) { max-width:580px; } .home-section { padding-top:52px; } .garden-line { flex-wrap:wrap; } .section-heading { align-items:start; flex-direction:column; gap:16px; } }
</style>
