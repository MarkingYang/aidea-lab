---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import { getKnowledge, topics } from '../lib/knowledge';
const { entries, topicIdsFor } = await getKnowledge();
const readingGroups = topics.map(topic => ({
  topic,
  articles: entries.filter(entry => topicIdsFor(entry).includes(topic.id)),
})).filter(group => group.articles.length > 0);
---
<BaseLayout title="阅读｜大飞随笔" description="关于 AI、研究、产品与组织的文章。">
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">READING</p>
      <h1>阅读</h1>
      <p class="intro-copy">关于 AI、研究、产品与组织的思考。</p>
    </header>
    {readingGroups.map(({ topic, articles }) => <section class="directory-section">
      <div class="section-heading"><h2>{topic.title}</h2><span class="quiet-label">{articles.length} 篇文章</span></div>
      <div class="ruled-list">{articles.map(entry => <EntryRow entry={entry} />)}</div>
    </section>)}
    {entries.length === 0 && <p class="empty-note">暂无文章。</p>}
  </div>
</BaseLayout>
