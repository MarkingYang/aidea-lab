---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesRow from '../../components/SeriesRow.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getKnowledge, topics } from '../../lib/knowledge';
export function getStaticPaths() { return topics.map(topic => ({params:{id:topic.id},props:{topic}})); }
const { topic } = Astro.props;
const { entries, series, seriesByArticle, topicIdsFor } = await getKnowledge();
const related = series.filter(item=>item.topic === topic.id);
const independent = entries.filter(entry=>!seriesByArticle.has(entry.id) && topicIdsFor(entry).includes(topic.id));
---
<BaseLayout title={`${topic.title}｜知识目录｜大飞随笔`} description={topic.description}>
  <div class="page-shell">
    <nav class="breadcrumbs" aria-label="面包屑"><a href="/topics/">知识目录</a><span>/</span><span aria-current="page">{topic.title}</span></nav>
    <header class="page-intro"><p class="eyebrow">{topic.english}</p><h1>{topic.question}</h1><p class="intro-copy">{topic.description}</p></header>
    {related.length > 0 && <section class="directory-section"><div class="section-heading"><h2>沿系列深入</h2><span class="quiet-label">全景 → 实践 → 整体思考</span></div><div class="ruled-list">{related.map((item,index)=><SeriesRow series={item} index={index}/>)}</div></section>}
    <section class="directory-section"><div class="section-heading"><h2>{related.length ? '相关观察与独立文章' : '从这些观察开始'}</h2><a href={`/library/?topic=${topic.id}`}>检索此方向的全部文章 →</a></div><div class="ruled-list">{independent.length ? independent.slice(0,8).map(entry=><EntryRow entry={entry}/>) : <p class="empty-note">这个方向目前以系列文章为主。可以从上方总览开始。</p>}</div>{independent.length > 8 && <a class="text-link" href={`/library/?topic=${topic.id}&scope=standalone`}>查看全部 {independent.length} 篇独立文章 →</a>}</section>
  </div>
</BaseLayout>
