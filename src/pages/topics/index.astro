---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKnowledge, topics, articleHref } from '../../lib/knowledge';
const { entries, series, topicIdsFor } = await getKnowledge();
const tags = [...new Set(entries.flatMap(entry => entry.data.topics))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
---
<BaseLayout title="知识目录｜大飞随笔" description="知识域、专题、文章三级目录：Harness、评测、产品与研究。">
  <div class="page-shell">
    <header class="page-intro"><p class="eyebrow">An atlas, not a feed</p><h1>用问题组织知识，<br />用实践连接理解。</h1><p class="intro-copy">目录分为知识域、专题、文章三级。先选方向，再展开对应专题；项目案例归到所研究的系统层级，关键词负责跨专题关联。</p></header>
    <nav class="directory-jump" aria-label="知识目录章节">{topics.map(topic => <a href={`#${topic.id}`}>{topic.title} ↓</a>)}<a href="/library/">搜索文章 ↗</a><a href="/graph/">进入知识星图 ↗</a></nav>
    <div class="knowledge-tree">
      {topics.map((topic,index) => {
        const children = series.filter(item => item.topic === topic.id);
        const count = entries.filter(entry => topicIdsFor(entry).includes(topic.id)).length;
        return <section class="domain-row" id={topic.id}>
          <header><p class="eyebrow">0{index+1} / {topic.english}</p><h2><a href={`/topics/${topic.id}/`}>{topic.title} ↗</a></h2><p>{topic.description}</p><small>{children.length} 个专题 · {count} 篇记录</small></header>
          <div class="domain-branches">{children.map(item => <details class="branch-topic"><summary><h3>{item.title}</h3><span>{item.articles.length} 篇</span></summary><p>{item.description}</p><ol>{item.articles.map(entry => <li><a href={articleHref(entry.id)}>{entry.data.title}</a></li>)}</ol><a class="topic-link" href={`/series/${item.id}/`}>打开专题 →</a></details>)}
            <a class="domain-more" href={`/topics/${topic.id}/`}>查看此方向的全部内容 →</a>
          </div>
        </section>;
      })}
    </div>
    <section class="tag-index"><h2>也可以从一个关键词进入</h2><p>主题是阅读方向，标签是跨主题的索引；同一篇文章可以有多个标签。</p><div>{tags.map(tag=><a href={`/library/?tag=${encodeURIComponent(tag)}`}>{tag}<small>{entries.filter(entry=>entry.data.topics.includes(tag)).length}</small></a>)}</div></section>
  </div>
</BaseLayout>
<style>
  .directory-jump { margin:38px 0 10px; padding:18px 0; display:flex; gap:26px; flex-wrap:wrap; border-block:1px solid var(--line); } .directory-jump a { font-size:12px; text-decoration:none; color:var(--text-soft); }
  .domain-row { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:70px; padding:48px 0; border-bottom:1px solid var(--line); scroll-margin-top:90px; }
  .domain-row h2 { font:400 32px var(--display); margin:20px 0 16px; } h2 a { text-decoration:none; }
  header > p:not(.eyebrow) { max-width:350px; color:var(--text-body); font-size:14px; line-height:1.9; } header small { color:var(--text-soft); font-size:11px; }
  .domain-branches { padding-left:26px; border-left:1px solid var(--line-strong); }
  .branch-topic { position:relative; border-bottom:1px solid var(--line); padding-bottom:22px; margin-bottom:22px; }
  .branch-topic summary { display:flex; align-items:baseline; justify-content:space-between; gap:18px; cursor:pointer; }
  .branch-topic summary::before { content:"+"; position:absolute; left:-33px; color:var(--accent); background:var(--bg); }
  .branch-topic[open] summary::before { content:"−"; }
  .branch-topic h3 { font-size:17px; margin:0; font-weight:500; }
  .branch-topic summary span { color:var(--text-soft); white-space:nowrap; font-size:11px; }
  .branch-topic p { color:var(--text-soft); font-size:12px; line-height:1.8; }
  .branch-topic ol { padding-left:20px; margin:18px 0; }
  .branch-topic li { padding:6px 0; font-size:13px; line-height:1.7; }
  .branch-topic li a { text-decoration:none; }
  .topic-link { font-size:12px; color:var(--accent); }
  .branch { position:relative; display:flex; justify-content:space-between; gap:20px; padding:0 0 24px; margin-bottom:22px; border-bottom:1px solid var(--line); text-decoration:none; }
  .branch::before { content:''; position:absolute; top:10px; left:-30px; width:7px; height:7px; background:var(--accent); border-radius:50%; }
  .branch h3 { margin:0; font-size:17px; font-weight:500; } .branch p { margin:9px 0 0; font-size:12px; line-height:1.8; color:var(--text-soft); } .branch span { color:var(--text-soft); font-size:11px; white-space:nowrap; padding-top:4px; }
  .branch:hover h3, a:hover { color:var(--accent); } .domain-more { color:var(--text-soft); font-size:12px; text-underline-offset:5px; }
  .open-question { padding:0 0 35px; } .open-question p { font:400 23px/1.7 var(--display); margin-top:0; }
  .tag-index { margin-top:64px; } .tag-index h2 { font:400 27px var(--display); } .tag-index p { font-size:13px; color:var(--text-soft); line-height:1.8; } .tag-index > div { display:flex; flex-wrap:wrap; gap:10px; margin-top:25px; } .tag-index a { padding:9px 12px; background:var(--surface); text-decoration:none; font-size:12px; } .tag-index small { margin-left:10px; color:var(--text-soft); font:10px var(--mono); }
  @media(max-width:720px) { .domain-row { grid-template-columns:1fr; gap:30px; } .domain-branches { margin-left:4px; } .directory-jump { gap:20px; } }
</style>
