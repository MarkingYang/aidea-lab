---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('writing');
const topicDescriptions: Record<string, string> = {
  产品思考: '观察 Agent Harness 正从对话入口走向可交付工作的产品阶段，并比较 OpenAI Codex、Claude Code 等产品在任务组织、权限边界、交互反馈与信任建立上的不同选择。',
  技术思考: '从基础模型、Agent 框架与 GitHub 开源项目出发，分析上下文管理、工具调用、记忆、评测与运行时架构的实现路径，以及这些技术取舍如何影响系统上限。',
  每周信号: '不复述一周的新闻，而是筛选可能改变产品形态、技术路线或竞争格局的变量，并记录这些判断后来被验证、修正或推翻的过程。',
  模型观察: '把基准分数还原到真实任务中，持续辨认模型在推理、编码、工具使用与长程执行上的能力边界，以及评测结果与实际体验为何发生偏差。',
  人机协同: '研究 AI 介入工作后出现的新协作模式：人从亲自执行转向定义目标、提供上下文、校准过程与承担判断，组织流程和个人能力结构也随之改变。',
  行业观察: '把新品发布、开源进展与商业动作放进同一张图里，判断价值正在向模型、工具链、分发入口还是工作流迁移，并寻找竞争格局中的长期结构变化。',
  'Agent Harness': '研究包裹模型并让 Agent 稳定工作的系统层：它如何组织上下文与工具、管理权限和状态、处理失败与恢复，以及把一次模型调用变成可追踪、可干预的任务过程。',
};
const topics = [...new Set(entries.flatMap((entry) => entry.data.topics))]
  .map((topic) => ({
    topic,
    entries: entries.filter((entry) => entry.data.topics.includes(topic)),
  }))
  .sort((a, b) => b.entries.length - a.entries.length || a.topic.localeCompare(b.topic, 'zh-CN'));
---

<BaseLayout title="主题｜大飞随笔" description="从主题而不是时间出发，探索彼此关联的 AI 思考。">
  <div class="page-shell">
    <header class="page-intro">
      <div><p class="eyebrow">KNOWLEDGE MAP</p><h1>想法不是列表，<br />它们彼此相连。</h1></div>
      <p class="intro-copy">主题是这座数字花园里的路径。同一篇记录可以出现在多条路径里，因为真实的思考很少只属于一个分类。</p>
    </header>
    <div class="topic-list">
      {topics.map(({ topic, entries }, index) => (
        <section class="topic-row">
          <span class="topic-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="topic-name"><h2>{topic}</h2><small>{entries.length} 篇记录</small></div>
          <div class="topic-content">
            <p>{topicDescriptions[topic] ?? `围绕「${topic}」整理相关观察与阶段性判断。`}</p>
            <ul aria-label={`${topic}相关文章`}>
              {entries.slice(0, 3).map((entry) => <li><a href={`/writing/${entry.id}/`}>{entry.data.title}<span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .topic-list { margin-top: 48px; border-top: 1px solid var(--line); }
  .topic-row { display: grid; grid-template-columns: 40px minmax(190px, .58fr) 1.42fr; gap: 24px; align-items: start; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .topic-index, .topic-name small { color: var(--text-soft); font: 10px var(--mono); }
  .topic-name h2 { margin: 0 0 8px; font-family: var(--display); font-size: 26px; font-weight: 400; }
  .topic-content > p { max-width: 680px; margin: 0; color: var(--text); font-size: 14px; line-height: 1.7; text-wrap: pretty; }
  ul { margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; }
  li + li { margin-top: 0; }
  li a { color: var(--text-soft); font-size: 12px; line-height: 1.6; text-decoration: none; }
  li a span { margin-left: 4px; }
  li a:hover { color: var(--accent); }
  @media (max-width: 680px) { .topic-list { margin-top: 38px; } .topic-row { grid-template-columns: 28px 1fr; gap: 16px; padding: 22px 0; } .topic-content { grid-column: 2; } }
</style>
