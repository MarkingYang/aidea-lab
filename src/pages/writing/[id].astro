---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtalkComments from '../../components/ArtalkComments.astro';
import MarkdownEnhancer from '../../components/MarkdownEnhancer.astro';
import 'katex/dist/katex.min.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'writing'>; }

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const typeLabels = { note: 'NOTE', essay: 'ESSAY', weekly: 'WEEKLY' };
const statusLabels = { seed: '种子', growing: '生长中', evergreen: '常青', archived: '归档' };
const published = entry.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const pageKey = `/writing/${entry.id}/`;
---

<BaseLayout title={`${entry.data.title}｜大飞随笔`} description={entry.data.description} image={null} ogType="article">
  <article class="article-shell">
    <header class="article-header">
      <div class="article-kicker">
        <span>{typeLabels[entry.data.type]}</span><span>·</span><time datetime={entry.data.publishedAt.toISOString()}>{published}</time>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="article-info">
        <div class="topics">{entry.data.topics.map((topic) => <a href="/topics/">#{topic}</a>)}</div>
        <div>
          <span>{entry.data.readingTime}</span>
          <span class="article-view-count" title="累计阅读量">
            阅读 <strong class="artalk-pv-count" data-page-key={pageKey}>--</strong>
          </span>
          <span class="article-comment-count" title="累计评论数">
            评论 <strong class="artalk-comment-count" data-page-key={pageKey}>--</strong>
          </span>
          <span class:list={['status', entry.data.status]}>{statusLabels[entry.data.status]}</span>
        </div>
      </div>
    </header>

    <div class="article-layout">
      <aside class="toc">
        <p>CONTENTS · 目录</p>
        {headings.length > 0 ? (
          <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        ) : <small>一则短笔记</small>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>

  <ArtalkComments title={entry.data.title} />
  <MarkdownEnhancer />
</BaseLayout>

<style>
  .article-shell { width: var(--page); margin: 0 auto; }
  .article-header { max-width: 860px; padding: var(--space-page-top) 0 38px; }
  .article-kicker { display: flex; gap: 10px; color: var(--text-soft); font: 10px var(--mono); letter-spacing: .08em; }
  .article-header h1 { max-width: 800px; margin: 18px 0 16px; font-family: var(--display); font-size: var(--display-article-size); font-weight: 400; line-height: 1.13; letter-spacing: -.04em; text-wrap: balance; }
  .article-header > p { max-width: 640px; margin: 0; color: var(--text-body); font-size: 15px; line-height: 1.78; text-wrap: pretty; }
  .article-info { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 28px; padding-top: 14px; border-top: 1px solid var(--line); font: 10px var(--mono); }
  .article-info > div { display: flex; align-items: center; gap: 10px; }
  .article-view-count, .article-comment-count { color: var(--text); }
  .article-view-count strong, .article-comment-count strong { font: inherit; }
  .topics a { color: var(--text-soft); text-underline-offset: 3px; }
  .status { padding: 5px 8px; border-radius: 6px; background: var(--surface); color: var(--text-soft); }
  .status.growing { background: var(--accent-soft); color: var(--accent); }
  .status.evergreen { background: var(--text); color: var(--bg); }
  .article-layout { display: grid; grid-template-columns: 190px minmax(0, var(--measure)); justify-content: center; gap: clamp(56px, 7vw, 92px); padding: 44px 0 24px; border-top: 1px solid var(--line); }
  .toc { align-self: start; position: sticky; top: 96px; padding-right: 24px; border-right: 1px solid var(--line); }
  .toc p { margin: 0 0 18px; color: var(--text-muted); font: 9px var(--mono); letter-spacing: .08em; }
  .toc ol { margin: 0; padding: 0; list-style: none; }
  .toc li + li { margin-top: 9px; }
  .toc a, .toc small { display: block; color: var(--text-soft); font-size: 11.5px; line-height: 1.62; text-decoration: none; transition: color .2s ease, transform .2s ease; }
  .toc a:hover { color: var(--accent); }
  .toc a[aria-current='location'] { color: var(--accent); transform: translateX(4px); }
  .prose { min-width: 0; color: var(--text-body); font-size: 16.5px; line-height: 1.92; letter-spacing: .005em; }
  .prose :global(h2) { margin: 58px 0 20px; color: var(--text); font-family: var(--display); font-size: 27px; font-weight: 400; line-height: 1.42; letter-spacing: -.02em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin: 44px 0 16px; color: var(--text); font-size: 20px; font-weight: 600; line-height: 1.5; letter-spacing: -.01em; }
  .prose :global(h4) { margin: 34px 0 12px; color: var(--text); font-size: 16.5px; font-weight: 600; line-height: 1.55; }
  .prose :global(p) { margin: 0 0 24px; text-wrap: pretty; }
  .prose :global(a) { color: var(--accent); text-underline-offset: 4px; }
  .prose :global(a:hover) { color: var(--accent-hover); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 28px; padding-left: 1.4em; }
  .prose :global(li) { margin: 7px 0; padding-left: .4em; }
  .prose :global(li::marker) { color: var(--text-soft); }
  .prose :global(.task-list-item) { padding-left: .15em; list-style: none; }
  .prose :global(.task-list-item input) { width: 15px; height: 15px; margin: 0 9px 0 -1.35em; accent-color: var(--accent); vertical-align: -.12em; }
  .prose :global(blockquote) { margin: 34px 0; padding: 21px 24px; border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 0 10px 10px 0; background: var(--surface-soft); color: var(--text-body); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 3%, transparent); }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(code) { padding: 3px 6px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--text); font: .82em var(--mono); }
  .prose :global(pre) { margin: 32px 0; padding: 21px 22px; overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; font: 13px/1.75 var(--mono); tab-size: 2; }
  .prose :global(pre code) { padding: 0; border: 0; background: transparent; font: inherit; }
  .prose :global(.astro-code) { background-color: var(--surface) !important; }
  :global(:root[data-theme='dark']) .prose :global(.astro-code),
  :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
  .prose :global(table) { width: 100%; margin: 32px 0; display: block; overflow-x: auto; border-spacing: 0; border-collapse: collapse; font-size: 14px; line-height: 1.65; }
  .prose :global(th), .prose :global(td) { min-width: 130px; padding: 12px 14px; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--surface); color: var(--text); font-weight: 600; }
  .prose :global(tr:nth-child(even) td) { background: color-mix(in srgb, var(--surface) 42%, transparent); }
  .prose :global(img) { max-width: 100%; height: auto; display: block; margin: 40px auto; border: 1px solid var(--line); border-radius: 12px; }
  .prose :global(video), .prose :global(iframe) { width: 100%; margin: 40px 0; display: block; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .prose :global(video) { height: auto; }
  .prose :global(iframe) { min-height: 405px; aspect-ratio: 16 / 9; }
  .prose :global(audio) { width: 100%; margin: 30px 0; }
  .prose :global(.katex-display) { margin: 36px 0; padding: 20px 4px; overflow-x: auto; overflow-y: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .prose :global(.katex) { font-size: 1.03em; }
  .prose :global(hr) { margin: 46px 0; border: 0; border-top: 1px solid var(--line); }
  .prose :global(del) { color: var(--text-soft); }
  .prose :global(mark) { padding: 1px 4px; border-radius: 3px; background: var(--accent-soft); color: var(--text); }
  .prose :global(kbd) { padding: 3px 6px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; background: var(--surface); font: 11px var(--mono); }
  .prose :global(details) { margin: 32px 0; padding: 17px 19px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-soft); }
  .prose :global(summary) { cursor: pointer; font-weight: 600; }
  .prose :global(details[open] summary) { margin-bottom: 14px; }
  .prose :global(.footnotes) { margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--line); color: var(--text-soft); font-size: 13px; }
  @media (max-width: 720px) {
    .article-header { padding-bottom: 32px; }
    .article-info { align-items: flex-start; flex-direction: column; }
    .article-layout { grid-template-columns: 1fr; padding-top: 34px; }
    .toc { display: none; }
    .prose { font-size: 16px; line-height: 1.88; }
    .prose :global(h2) { margin-top: 50px; font-size: 25px; }
    .prose :global(iframe) { min-height: 220px; }
  }
</style>
