---
import { stageLabel, type KnowledgeSeries } from '../lib/knowledge';
interface Props { series: KnowledgeSeries; index?: number; }
const { series, index = 0 } = Astro.props;
---
<article class="series-row">
  <span class="row-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div>
    <p class="series-meta">{series.articles.length} 篇 · 约 {series.minutes} 分钟 · 可分次阅读</p>
    <h3><a href={`/series/${series.id}/`}>{series.title}<span aria-hidden="true">↗</span></a></h3>
    <p class="series-description">{series.description}</p>
    <div class="chapter-track" aria-label="阅读结构">
      {series.articles.map((_, i) => <span class:list={{ endpoint: i === 0 || i === series.articles.length - 1 }} title={`第 ${i + 1} 篇 · ${stageLabel(i, series.articles.length)}`}>{String(i + 1).padStart(2, '0')}</span>)}
      <small>总览 → 实践 → 思考</small>
    </div>
  </div>
  <a class="series-enter" href={`/series/${series.id}/`}>打开目录 <span aria-hidden="true">→</span></a>
</article>
<style>
  .series-row { display:grid; grid-template-columns:36px minmax(0,1fr) auto; gap:24px; padding:30px 0; border-bottom:1px solid var(--line); }
  .row-number { padding-top:3px; color:var(--accent); font:12px var(--mono); }
  .series-meta { margin:0 0 12px; color:var(--text-soft); font-size:11px; }
  h3 { margin:0; font:400 clamp(24px,2.4vw,30px)/1.3 var(--display); }
  h3 a { text-decoration:none; } h3 span { margin-left:14px; color:var(--text-muted); font:18px var(--sans); }
  h3 a:hover, .series-enter:hover { color:var(--accent); }
  .series-description { max-width:620px; margin:12px 0 18px; color:var(--text-body); font-size:14px; line-height:1.8; }
  .chapter-track { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .chapter-track span { padding:5px 7px; background:var(--surface); color:var(--text-soft); font:10px var(--mono); }
  .chapter-track .endpoint { background:var(--accent-soft); color:var(--accent); }
  .chapter-track small { margin-left:6px; color:var(--text-soft); font-size:10px; }
  .series-enter { align-self:center; color:var(--text-soft); text-decoration:none; font-size:12px; padding:10px 0 10px 12px; white-space:nowrap; }
  @media(max-width:640px) { .series-row { grid-template-columns:24px minmax(0,1fr); gap:12px; } .series-enter { grid-column:2; justify-self:start; padding:2px 0; } }
</style>
