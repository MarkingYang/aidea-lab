---
import { getKnowledge, topics, dateLabel, articleHref, updated, type Writing } from '../lib/knowledge';
import { PAGE_SIZE, pageWindow } from '../lib/library';
interface Props { initialEntries: Writing[]; currentPage: number; totalPages: number; }
const { initialEntries, currentPage, totalPages } = Astro.props;
const {entries,series,seriesByArticle,topicIdsFor}=await getKnowledge();
const records=entries.map(entry=>{
  const parent=seriesByArticle.get(entry.id);
  return {id:entry.id,title:entry.data.title,description:entry.data.description,tags:entry.data.topics,topics:topicIdsFor(entry),type:entry.data.type,status:entry.data.status,series:parent?.id??'',seriesTitle:parent?.title??'',chapter:parent ? parent.articles.findIndex(item=>item.id===entry.id)+1 : 0,published:entry.data.publishedAt.toISOString(),updated:updated(entry).toISOString(),minutes:Number.parseInt(entry.data.readingTime)||0,readingTime:entry.data.readingTime};
});
const tags=[...new Set(entries.flatMap(entry=>entry.data.topics))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
const pageHref=(n:number)=>n===1?'/library/':`/library/${n}/`;
---
<section class="library" data-initial-page={currentPage} aria-label="文章检索与目录">
  <form class="library-controls" hidden role="search" aria-label="搜索文章">
    <div class="search-field"><label for="library-query">找一个问题、一种方法，或一篇文章</label><div><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg><input id="library-query" name="q" type="search" placeholder="搜索标题、摘要、标签、系列…" autocomplete="off" /><button type="submit">搜索 →</button></div></div>
    <div class="library-filters">
      <label>阅读方向<select name="topic"><option value="">全部方向</option>{topics.map(topic=><option value={topic.id}>{topic.title}</option>)}</select></label>
      <label>系列<select name="series"><option value="">全部系列</option>{series.map(item=><option value={item.id}>{item.title}</option>)}</select></label>
      <label>内容范围<select name="scope"><option value="">全部记录</option><option value="series">系列章节</option><option value="standalone">独立文章</option></select></label>
      <label>关键词标签<select name="tag"><option value="">全部标签</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></label>
      <label>类型<select name="type"><option value="">全部类型</option><option value="essay">文章</option><option value="note">随想笔记</option><option value="weekly">每周信号</option></select></label>
      <label>排列方式<select name="sort"><option value="updated">最近修订 / 系列顺序</option><option value="published">最新发布</option><option value="shortest">阅读时间最短</option><option value="title">标题顺序</option></select></label>
    </div>
    <div class="filter-summary"><p>输入多个关键词以空格分隔，匹配所有关键词。</p><button type="button" data-reset>清除筛选</button></div>
  </form>
  <noscript><p class="empty-note">当前显示静态文章目录，可使用下方页码浏览全部记录。搜索与筛选需要启用 JavaScript；也可前往<a href="/topics/">知识目录</a>按主题阅读。</p></noscript>
  <div class="library-summary"><p data-result-count role="status" aria-live="polite">{entries.length} 篇记录 · 第 {currentPage} / {totalPages} 页</p><span>每页 {PAGE_SIZE} 篇</span></div>
  <div data-results>
    {initialEntries.map(entry=>{const parent=seriesByArticle.get(entry.id);return <article class="library-result"><div class="result-body"><p class="result-context">{parent ? <a href={`/series/${parent.id}/`}>{parent.title} · 第 {parent.articles.findIndex(item=>item.id===entry.id)+1} 篇</a> : '独立记录'}<span> / {entry.data.topics[0]}</span></p><h2><a href={articleHref(entry.id)}>{entry.data.title}</a></h2><p class="result-description">{entry.data.description}</p></div><div class="result-meta"><time datetime={updated(entry).toISOString()}>{dateLabel(updated(entry))}</time><span>{entry.data.readingTime}</span></div></article>})}
  </div>
  <div class="library-empty" hidden><p>暂时没有找到匹配的文章。</p><span>试试更短的关键词，或清除方向、系列和标签筛选。</span><button type="button" data-reset>清除筛选，浏览全部</button></div>
  <nav class="library-pagination" aria-label="文章分页">{pageWindow(currentPage,totalPages).map(n=><a href={pageHref(n)} aria-label={`第 ${n} 页`} aria-current={n===currentPage?'page':undefined}>{n}</a>)}</nav>
  <script type="application/json" data-library-index set:html={JSON.stringify(records).replaceAll('<','\u003c')} />
</section>
<script>
  import { readFilters, filterLibrary, paginateLibrary, pageWindow, filtersUrl, type LibraryEntry } from '../lib/library';
  const root=document.querySelector<HTMLElement>('.library');
  if(root) {
    const records:LibraryEntry[]=JSON.parse(root.querySelector('[data-library-index]')!.textContent!);
    const form=root.querySelector<HTMLFormElement>('form')!;
    const results=root.querySelector<HTMLElement>('[data-results]')!;
    const pagination=root.querySelector<HTMLElement>('.library-pagination')!;
    const count=root.querySelector<HTMLElement>('[data-result-count]')!;
    const empty=root.querySelector<HTMLElement>('.library-empty')!;
    const query=form.querySelector<HTMLInputElement>('[name="q"]')!;
    let filters=readFilters(new URLSearchParams(location.search));
    if(!new URLSearchParams(location.search).has('page')) filters.page=Number(root.dataset.initialPage)||1;
    let timer:ReturnType<typeof setTimeout>;
    function syncForm() {
      for(const input of form.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[name]')) {
        const key=input.name as keyof typeof filters;
        const value=String(filters[key]);
        // Preserve unknown URL filters visibly so they can be cleared rather than silently ignored.
        if(input instanceof HTMLSelectElement && value && ![...input.options].some(option=>option.value===value)) input.add(new Option('未知筛选：'+value,value));
        input.value=value;
      }
    }
    function el<K extends keyof HTMLElementTagNameMap>(tag:K,cls:string,text?:string) {
      const node=document.createElement(tag);node.className=cls;if(text) node.textContent=text;return node;
    }
    function render(updateUrl=false,push=false) {
      const filtered=filterLibrary(records,filters);
      const page=paginateLibrary(filtered,filters.page);filters.page=page.current;
      const fragment=document.createDocumentFragment();
      for(const entry of page.entries) {
        const article=el('article','library-result'),body=el('div','result-body'),context=el('p','result-context');
        if(entry.series) {const link=el('a','',entry.seriesTitle+' · 第 '+entry.chapter+' 篇');link.href='/series/'+entry.series+'/';context.append(link);} else context.append('独立记录');
        context.append(el('span','',' / '+entry.tags[0]));
        const title=el('h2',''),link=el('a','',entry.title);link.href='/writing/'+entry.id+'/';title.append(link);
        body.append(context,title,el('p','result-description',entry.description));
        const meta=el('div','result-meta'),time=el('time','',entry.updated.slice(0,10).replaceAll('-','.'));time.dateTime=entry.updated;meta.append(time,el('span','',entry.readingTime));article.append(body,meta);fragment.append(article);
      }
      results.replaceChildren(fragment);empty.hidden=filtered.length>0;
      count.textContent=filtered.length+' 篇匹配记录 · 第 '+page.current+' / '+page.pages+' 页';
      pagination.replaceChildren();pagination.hidden=filtered.length===0;
      let previous=0;
      for(const n of pageWindow(page.current,page.pages)) {
        if(n-previous>1) pagination.append(el('span','','…'));previous=n;
        const link=el('a','',String(n));link.href=filtersUrl({...filters,page:n});link.setAttribute('aria-label','第 '+n+' 页');
        if(n===page.current) link.setAttribute('aria-current','page');
        link.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();clearTimeout(timer);filters.page=n;render(true,true);count.tabIndex=-1;count.focus({preventScroll:true});count.scrollIntoView({behavior:'auto',block:'start'});});pagination.append(link);
      }
      if(updateUrl) {const url=filtersUrl(filters);if(push) history.pushState(null,'',url);else history.replaceState(null,'',url);}
    }
    function fromForm() {filters=readFilters(new URLSearchParams([...new FormData(form)].map(([key,value])=>[key,String(value)])));filters.page=1;}
    query.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{fromForm();render(true);},160);});
    form.addEventListener('change',()=>{clearTimeout(timer);fromForm();render(true,true);});
    form.addEventListener('submit',event=>{event.preventDefault();clearTimeout(timer);fromForm();render(true);});
    root.querySelectorAll('[data-reset]').forEach(button=>button.addEventListener('click',()=>{clearTimeout(timer);filters=readFilters(new URLSearchParams());syncForm();render(true,true);query.focus();}));
    window.addEventListener('popstate',()=>{clearTimeout(timer);filters=readFilters(new URLSearchParams(location.search));if(!new URLSearchParams(location.search).has('page')) filters.page=Number(location.pathname.match(/^\/library\/(\d+)\//)?.[1])||1;syncForm();render();});
    syncForm();render();form.hidden=false;
  }
</script>
<style is:global>
  .library { margin-top:40px; }
  .library-controls { padding:28px; background:var(--surface-soft); border:1px solid var(--line); }
  .search-field > label { display:block; font-size:13px; margin-bottom:15px; }
  .search-field > div { display:flex; align-items:center; border-bottom:1px solid var(--line-strong); gap:14px; padding:0 0 12px; }
  .search-field svg { width:20px; height:20px; fill:none; stroke:var(--text-soft); stroke-width:1.4; flex-shrink:0; }
  .search-field input { flex:1; min-width:0; padding:10px 0; border:0; border-radius:0; background:transparent; color:var(--text); font-size:17px; }
  .search-field button,.filter-summary button { border:0; background:none; color:var(--accent); cursor:pointer; font-size:12px; padding:10px 0 10px 10px; white-space:nowrap; }
  .library-filters { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:25px; }
  .library-filters label { min-width:0; font-size:11px; color:var(--text-soft); }
  .library-filters select { width:100%; margin-top:8px; border:1px solid var(--line); border-radius:3px; padding:10px; background:var(--bg); color:var(--text-body); font-size:12px; }
  .filter-summary { display:flex; justify-content:space-between; align-items:center; gap:18px; margin-top:16px; } .filter-summary p { color:var(--text-soft); font-size:11px; line-height:1.8; margin:0; }
  .library-summary { display:flex; justify-content:space-between; gap:20px; align-items:center; padding:24px 0 16px; border-bottom:1px solid var(--line); color:var(--text-soft); font-size:11px; }
  .library-summary p { margin:0; scroll-margin-top:90px; }
  .library-result { display:grid; grid-template-columns:minmax(0,1fr) 95px; gap:35px; padding:25px 0; border-bottom:1px solid var(--line); }
  .result-context { margin:0 0 10px; color:var(--text-soft); font-size:11px; line-height:1.8; }
  .result-context a { color:var(--accent); text-decoration:none; } .result-context a:hover { text-decoration:underline; }
  .library-result h2 { margin:0; font:500 18px/1.65 var(--sans); } .library-result h2 a { text-decoration:none; } .library-result h2 a:hover { color:var(--accent); }
  .result-description { max-width:880px; margin:9px 0 0; color:var(--text-soft); font-size:13px; line-height:1.9; }
  .result-meta { display:flex; flex-direction:column; align-items:end; gap:12px; color:var(--text-soft); font:11px var(--mono); padding-top:4px; }
  .library-pagination { display:flex; flex-wrap:wrap; gap:10px; padding-top:32px; align-items:center; }
  .library-pagination a { width:38px; height:38px; display:grid; place-items:center; border:1px solid var(--line); color:var(--text-soft); text-decoration:none; font:12px var(--mono); }
  .library-pagination a[aria-current='page'] { background:var(--text); color:var(--bg); border-color:var(--text); }
  .library-pagination a:hover { border-color:var(--accent); }
  .library-empty { padding:45px 0; } .library-empty p { font:400 28px var(--display); } .library-empty span { display:block; color:var(--text-soft); font-size:13px; line-height:1.8; } .library-empty button { display:block; padding:12px 0; margin-top:16px; border:0; background:none; color:var(--accent); cursor:pointer; }
  @media(max-width:640px) { .library-controls { padding:18px; } .library-filters { grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px 12px; } .search-field input { font-size:16px; } .search-field > div { gap:10px; } .library-result { grid-template-columns:1fr; gap:15px; } .result-meta { flex-direction:row; gap:16px; padding:0; } .library-result h2 { font-size:17px; } }
</style>
