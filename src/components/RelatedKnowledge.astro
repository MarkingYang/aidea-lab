---
import type { RelatedArticle } from '../lib/knowledgeGraph';

interface Props {
  articleId: string;
  related: RelatedArticle[];
}

const { articleId, related } = Astro.props;
---

<section class="related-knowledge" aria-labelledby="related-knowledge-title">
  <header>
    <div><p>KNOWLEDGE CONNECTIONS · 相关知识</p><h2 id="related-knowledge-title">从这篇文章，继续向外走。</h2></div>
    <a href={`/graph/?node=${articleId}&view=local`}>在知识星图中查看 <span>↗</span></a>
  </header>
  {related.length ? <ol>
    {related.map((item) => <li><a href={item.href}><span class="relation">{item.relationLabel} · {item.reasons.join('、')}</span><strong>{item.title}</strong><p>{item.description}</p></a></li>)}
  </ol> : <p class="empty">这篇文章正在生长，新的关联会随内容更新自动出现。</p>}
</section>

<style>
  .related-knowledge { max-width: 980px; margin: 58px auto 0; padding: 30px 0 8px; border-top: 1px solid var(--line); }
  .related-knowledge header { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .related-knowledge header p { margin: 0; color: var(--text-soft); font: 9px var(--mono); letter-spacing: .09em; }
  .related-knowledge h2 { margin: 11px 0 0; font: 400 25px/1.35 var(--display); }
  .related-knowledge header > a { flex: 0 0 auto; color: var(--accent); font-size: 12px; text-underline-offset: 5px; }
  .related-knowledge ol { margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); list-style: none; }
  .related-knowledge li { min-width: 0; border-bottom: 1px solid var(--line); }
  .related-knowledge li:nth-child(odd) { padding-right: 22px; border-right: 1px solid var(--line); }
  .related-knowledge li:nth-child(even) { padding-left: 22px; }
  .related-knowledge li a { min-height: 150px; padding: 19px 0; display: block; text-decoration: none; }
  .related-knowledge .relation { display: block; overflow: hidden; color: var(--accent); font: 9px var(--mono); text-overflow: ellipsis; white-space: nowrap; }
  .related-knowledge strong { display: block; margin-top: 10px; font-size: 14px; font-weight: 500; line-height: 1.6; transition: color .2s, transform .2s; }
  .related-knowledge li a:hover strong { color: var(--accent); transform: translateX(3px); }
  .related-knowledge li p, .empty { margin: 8px 0 0; color: var(--text-soft); font-size: 11.5px; line-height: 1.75; }
  .empty { padding: 24px 0; border-top: 1px solid var(--line); }
  @media(max-width: 700px) {
    .related-knowledge { margin-top: 45px; }
    .related-knowledge header { align-items: start; flex-direction: column; gap: 16px; }
    .related-knowledge ol { grid-template-columns: 1fr; }
    .related-knowledge li:nth-child(odd), .related-knowledge li:nth-child(even) { padding-inline: 0; border-right: 0; }
    .related-knowledge li a { min-height: 0; }
  }
</style>
