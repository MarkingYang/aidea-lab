[Unit]
Description=Artalk comment service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=artalk
Group=artalk
WorkingDirectory=/var/lib/artalk
EnvironmentFile=/etc/artalk/artalk.env
ExecStart=/usr/local/bin/artalk server --host 127.0.0.1 --port 23366
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/artalk

[Install]
WantedBy=multi-user.target

